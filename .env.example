# Local configuration for the Replay-to-Repair demo.
#
# Copy this file to `.env` (git-ignored) and set the key for the
# owner-selection engine you run:
#
#   cp .env.example .env
#
# `make` loads `.env` for every target. Every variable below is optional
# except the API key of the engine in use; commented-out lines show the
# default the application falls back to.

# --- Owner selection: Anthropic, the default engine ------------------------

# Anthropic key, required by `make app-up`, `make dev` and `make test-live`.
ANTHROPIC_API_KEY=

# Claude model used for owner triage.
#ANTHROPIC_MODEL=claude-sonnet-5

# --- Owner selection: Jev, the `jev` profile -------------------------------

# TypeSafe key, required by `make app-up-jev`, `make dev-jev` and
# `make test-live`. These targets need no Anthropic key.
#TYPESAFE_API_KEY=

# Jev model used for owner triage.
#TYPESAFE_MODEL=jev-latest

# --- Temporal --------------------------------------------------------------

# gRPC endpoint the worker and the backend connect to.
#TEMPORAL_ADDRESS=localhost:7233

# Namespace the Workflows run in.
#TEMPORAL_NAMESPACE=default

# --- Worker metrics --------------------------------------------------------

# Port Actuator serves the worker's metrics on, scraped at
# /actuator/prometheus in Prometheus or OpenMetrics format.
#WORKER_MANAGEMENT_PORT=8082
