<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.temporal.demos.replaytorepair</groupId>
    <artifactId>replay-to-repair-worker</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Replay-to-Repair :: Worker</name>
    <description>Temporal worker for the Replay-to-Repair demo</description>

    <properties>
        <java.version>25</java.version>
        <temporal.version>1.39.0</temporal.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <spring-ai-agent-utils.version>0.12.0</spring-ai-agent-utils.version>
        <typesafe.version>0.1.0</typesafe.version>
        <!-- JUnit tags left out of the test run. See the surefire configuration below. -->
        <excluded.test.groups>live</excluded.test.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- Temporal: this module hosts the worker(s). @WorkflowImpl and
             @ActivityImpl beans are auto-discovered and registered on the
             configured task queue by the starter. -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-spring-boot-starter</artifactId>
            <version>${temporal.version}</version>
        </dependency>

        <!-- Spring AI model starter: powers the owner-selection Activity that
             calls out to the LLM. The artifact below selects the model provider. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <!-- spring-ai-community agent utils: SkillsTool loads the agentskills.io
             owner-selection skill and exposes it to the LLM as a tool. -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <version>${spring-ai-agent-utils.version}</version>
        </dependency>

        <!-- spring-ai-community TypeSafe starter: auto-configures from
             spring.ai.typesafe.* the TypeSafeClient the Jev engine asks its
             owner-selection question through. -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-starter-typesafe</artifactId>
            <version>${typesafe.version}</version>
        </dependency>

        <!-- Actuator publishes the application's metrics over HTTP, one
             plain reading per meter under /actuator/metrics. The web starter
             below provides the servlet container those endpoints need: the
             actuator starter on its own exposes nothing over HTTP. The plain
             Micrometer API used to record the metrics needs no AOP, proxying
             or reflection. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Prometheus meter registry: the registry the application records
             into, and what turns on the OpenMetrics/Prometheus scrape
             endpoint at /actuator/prometheus. The version comes from the
             Spring Boot BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Temporal test support: replay event histories and exercise
             Activities directly from captured production data. -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-testing</artifactId>
            <version>${temporal.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- The `live` tag marks OwnerSelectorTest and JevOwnerSelectorTest, which call the
                 paid Anthropic and TypeSafe APIs for real. They stay out of the default run, which
                 is therefore offline and needs no API key. Clear the property to run them:
                 ./mvnw test -Dexcluded.test.groups= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
